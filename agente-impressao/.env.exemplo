# =====================================================================
#  Agente de impressão — configuração
#  Copie este arquivo para ".env" (sem o .exemplo) e preencha.
# =====================================================================

# Endereço do sistema, o mesmo que você usa no navegador
URL_SISTEMA=https://cardapio.brasaviva.com.br

# Senha combinada entre o sistema e este agente.
# Precisa ser IGUAL à variável TOKEN_IMPRESSAO configurada no servidor.
TOKEN_IMPRESSAO=

# De quantos em quantos segundos procurar comanda nova
INTERVALO_SEGUNDOS=4


# =====================================================================
#  Como a impressora está ligada. Escolha UM dos três blocos.
# =====================================================================

# --- 1) Impressora instalada no Windows (USB ou compartilhada) --------
# É o caso mais comum. Compartilhe a impressora no Windows
# (Painel de Controle > Impressoras > botão direito > Compartilhamento)
# e coloque aqui o NOME DO COMPARTILHAMENTO, sem espaços.
IMPRESSORA_TIPO=windows
IMPRESSORA_NOME=COZINHA

# --- 2) Impressora de rede (tem cabo de rede ou wi-fi) ---------------
# IMPRESSORA_TIPO=rede
# IMPRESSORA_HOST=192.168.0.50
# IMPRESSORA_PORTA=9100

# --- Duas impressoras? (opcional) -------------------------------------
# Cada comanda chega com um destino ("via"):
#   viagem = entrega e retirada   |   salao = pedidos de mesa
# Sem nada aqui, tudo sai na impressora padrão configurada acima.
# Para separar, aponte cada via para o nome do compartilhamento
# (ou, se IMPRESSORA_TIPO=rede, para o IP — aceita IP:porta):
# IMPRESSORA_VIA_VIAGEM=I7PLUS
# IMPRESSORA_VIA_SALAO=COZINHA

# --- 3) Sem impressora, só para testar --------------------------------
# Em vez de imprimir, grava a comanda em arquivo E mostra na tela:
#   comanda-<id>.txt  legível, é o que você lê para conferir
#   comanda-<id>.bin  o que sairia na impressora, byte a byte
# IMPRESSORA_TIPO=arquivo
# PASTA_SAIDA=C:\comandas
# Para não despejar a comanda no terminal, descomente:
# MOSTRAR_NA_TELA=nao
