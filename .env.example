# =====================================================================
# Supabase — obrigatório
# Pegue em: Supabase > seu projeto > Project Settings > API
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Chave secreta (service_role). NUNCA exponha no navegador nem no git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# =====================================================================
# URL pública do app — usada nos retornos do pagamento e no webhook
# Em produção: https://cardapio.seudominio.com.br
# =====================================================================
NEXT_PUBLIC_URL_BASE=http://localhost:3000

# =====================================================================
# InfinitePay — pagamento online por link (Pix taxa zero e cartão 12x)
# Basta a InfiniteTag da conta (o "$nome" no app), com ou sem o $.
# Com ela preenchida, o pagamento online usa a InfinitePay; o cliente é
# levado ao checkout deles e volta sozinho. Sem chave secreta: a
# confirmação é conferida ativamente no payment_check.
# =====================================================================
INFINITEPAY_HANDLE=

# =====================================================================
# Mercado Pago — opcional (Checkout Transparente: Pix e cartão no site)
# Usado só se a InfinitePay estiver vazia. Sem nenhum dos dois o app
# funciona normalmente, só com "pagar na entrega/retirada".
# Credenciais em: mercadopago.com.br/developers > Suas integrações
# =====================================================================
# Access Token (secreto, fica só no servidor)
MP_ACCESS_TOKEN=
# Public Key (vai para o navegador, carrega o formulário de pagamento)
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Assinatura secreta do webhook (Suas integrações > Webhooks > Configurar)
MP_WEBHOOK_SECRET=

# =====================================================================
# WhatsApp (uazapi) — opcional
# Sem isso o cliente não recebe aviso automático; o painel continua
# abrindo a conversa com um clique.
# =====================================================================
UAZAPI_URL=https://sua-instancia.uazapi.com
UAZAPI_TOKEN=

# =====================================================================
# Fuso do restaurante (padrão: America/Sao_Paulo)
# =====================================================================
NEXT_PUBLIC_FUSO_HORARIO=America/Sao_Paulo

# =====================================================================
# Impressão automática — opcional
# Senha combinada com o agente que roda no PC do restaurante
# (pasta agente-impressao). Sem isso, a comanda só sai clicando.
# =====================================================================
TOKEN_IMPRESSAO=

# =====================================================================
# Só para rodar os testes automatizados na sua máquina.
# Nada disso é usado pelo app em produção.
# =====================================================================
TESTE_EMAIL_ADMIN=
TESTE_SENHA_ADMIN=
TESTE_SENHA_ATENDENTE=
